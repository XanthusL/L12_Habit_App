<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>View Habit</title>
</head>
<body>
    <%- include('partials/header') %>
    <h1>View Habit</h1>
    <p><strong>Name:</strong> <%= habit.name %></p>
    <p><strong>Frequency:</strong> <%= habit.frequency %></p>
    <p><strong>Start Date:</strong> <%= habit.startDate %></p>
    <p><strong>End Date:</strong> <%= habit.endDate %></p>
    <p><strong>Category:</strong> <%= habit.category %></p>
    <p><strong>Reminder Time:</strong> <%= habit.reminderTime %></p>
    <p><strong>Status:</strong> <%= habit.status %></p>
    <p><strong>Notes:</strong> <%= habit.notes %></p>
</body>
</html>